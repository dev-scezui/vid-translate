PORT=3000

# Translation (Claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Transcription: any OpenAI-compatible speech-to-text endpoint
TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
# Groq example (fast, cheap Whisper):
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Downloading
# YT_DLP_COOKIES=/path/to/cookies.txt   # helps with Instagram/Facebook rate limits
# MAX_DURATION_SEC=3600
# MAX_CONCURRENT_JOBS=2

# Database: Supabase (Project Settings -> API). Server-side only - never ship the service-role key to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Accounts & limits (plans live in the `plans` table)
ADMIN_TOKEN=change-me-to-a-long-random-string
# SIGNUPS_PER_IP_PER_DAY=3
# TRUST_PROXY=1   # set when behind a reverse proxy / load balancer

# Billing: Stripe (Developers -> API keys). Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe, or from `stripe listen` locally
STRIPE_WEBHOOK_SECRET=
# Public URL of this app, used for the Checkout/Portal return links
APP_URL=http://localhost:3000
